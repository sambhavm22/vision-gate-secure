{
    "name": "vision-gate-monorepo",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "dev": "concurrently \"npm run dev --workspace=@vision-gate/worker-app\" \"npm run dev --workspace=vite_react_shadcn_ts\""
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}
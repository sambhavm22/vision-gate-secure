{
  "name": "vision-gate-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "all": "concurrently \"npm run dev --workspace=@vision-gate/worker-app\" \"npm run dev --workspace=vite_react_shadcn_ts\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "expo": "^54.0.33",
    "expo-location": "~19.0.8"
  }
}
